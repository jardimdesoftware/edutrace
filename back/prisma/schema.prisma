// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  WAITING
  IN_SERVICE
  CLOSED
}

enum CommentType {
  NOTE
  CLASS_COUNCIL_REPORT
}

model User {
  id                      Int        @id @default(autoincrement())
  full_name               String
  cpf                     String     @unique
  email                   String     @unique
  password                String
  affliation              String?
  password_reset_token    String?
  password_reset_expires  DateTime?
  password_reset_attempts Int        @default(0)
  activation_token        String?    @unique
  activation_expires      DateTime?
  must_change_password    Boolean    @default(false)
  failed_login_attempts   Int        @default(0)
  locked_until            DateTime?
  login_lock_count        Int        @default(0)
  google_sub              String?    @unique
  enrollment_number       String?    @unique
  course                  String?
  comments                Comments[]
  sessions                Session[]
  created_at              DateTime   @default(now())
  updated_at              DateTime?  @updatedAt
  deleted_at              DateTime?

  service_status       ServiceStatus?
  queued_at            DateTime?
  service_started_at   DateTime?
  service_closed_at    DateTime?
  service_capacity     Int?
  napne_responsible_id Int?
  napne_responsible    User?          @relation("NapneStudents", fields: [napne_responsible_id], references: [id], onDelete: SetNull)
  napne_students       User[]         @relation("NapneStudents")

  pedagogical_manager_id     Int?
  pedagogical_manager        User?   @relation("PedagogicalManager", fields: [pedagogical_manager_id], references: [id], onDelete: SetNull)
  managed_students           User[]  @relation("PedagogicalManager")
  external_manager_name      String?
  external_manager_phone     String?
  external_manager_cpf       String?
  pedagogical_manager_legacy String? @ignore

  case_study            CaseStudy?  @relation("CaseStudyStudent")
  authored_case_studies CaseStudy[] @relation("CaseStudyAuthor")

  aee_plans          AeePlan[] @relation("AeePlanStudent")
  authored_aee_plans AeePlan[] @relation("AeePlanAuthor")

  pei_entries          PeiEntry[] @relation("PeiEntryStudent")
  authored_pei_entries PeiEntry[] @relation("PeiEntryAuthor")

  roles Int[]

  id_current_phase Int
  current_phase    CurrentPhases @relation(fields: [id_current_phase], references: [id])

  @@index([napne_responsible_id, service_status])
  @@index([service_status, queued_at])
  @@index([pedagogical_manager_id])
}

model Session {
  id           Int       @id @default(autoincrement())
  jti          String    @unique
  ip           String?
  user_agent   String?
  created_at   DateTime  @default(now())
  last_used_at DateTime  @default(now())
  revoked_at   DateTime?

  id_user Int
  user    User @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@index([id_user])
}

model Level {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?
}

model Screening {
  id                  Int       @id @default(autoincrement())
  full_name           String
  email               String    @unique
  report              String?
  specific_need       Json
  special_service     Boolean
  physical_disability Json
  visual_impairment   Json
  hearing_impairment  Json
  global_disorder     Json
  other_disabilities  String?
  created_at          DateTime  @default(now())
  updated_at          DateTime? @updatedAt
  deleted_at          DateTime?
}

model Comments {
  id          Int            @id @default(autoincrement())
  comment     String
  type        CommentType    @default(NOTE)
  id_author   Int
  author_name String
  created_at  DateTime       @default(now())
  updated_at  DateTime?      @updatedAt
  deleted_at  DateTime?
  edits       CommentEdits[]

  id_user Int
  user    User @relation(fields: [id_user], references: [id])

  @@index([id_user, id])
}

model CommentEdits {
  id         Int      @id @default(autoincrement())
  comment    String
  created_at DateTime @default(now())

  id_comment Int
  parent     Comments @relation(fields: [id_comment], references: [id], onDelete: Cascade)

  @@index([id_comment])
}

model CurrentPhases {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  users      User[]
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?
}

model Anamnesis {
  id                          Int       @id @default(autoincrement())
  email                       String    @unique
  identification              Json
  family_data                 Json
  family_conditions           Json
  mother_background           Json
  verbal_language_three_years Json
  development                 Json
  school_information          Json
  sexuality                   Json
  student_assessment          Json
  student_development         Json
  created_at                  DateTime  @default(now())
  updated_at                  DateTime? @updatedAt
  deleted_at                  DateTime?
}

model PlansEducationLegacy {
  id                         Int       @id @default(autoincrement())
  professor_email            String
  professor_name             String
  student_email              String    @unique
  student_name               String
  academic_semester          Json
  service_modality           Json
  support_service            Json
  skills                     Json
  resource_equipment_used    Json
  resource_equipment_needs   Json
  curriculum_accessibility   Json
  school_content             String
  activities_to_be_developed Json
  objectives                 String
  work_methodology           Json
  materials_used             Json
  evaluation_criteria        Json
  created_at                 DateTime  @default(now())
  updated_at                 DateTime? @updatedAt
  deleted_at                 DateTime?

  @@map("PlansEducation_legacy")
}

model CaseStudy {
  id                       Int       @id @default(autoincrement())
  identification           Json
  general_info             Json
  school_history           Json
  pedagogical_aspects      Json
  behavioral_social        Json
  potentialities_interests String
  barriers                 String
  resources_strategies     Json
  pei_recommendations      Json
  aee_opinion              Json
  created_at               DateTime  @default(now())
  updated_at               DateTime? @updatedAt

  id_student Int  @unique
  student    User @relation("CaseStudyStudent", fields: [id_student], references: [id], onDelete: Restrict)

  id_author Int?
  author    User? @relation("CaseStudyAuthor", fields: [id_author], references: [id], onDelete: SetNull)

  @@index([id_author])
}

model AeePlan {
  id                    Int       @id @default(autoincrement())
  semester              String
  identification        Json
  basis                 String
  has_diagnosis         Boolean
  supports              Json
  purpose               Json
  objectives            Json
  evaluation_procedures String
  created_at            DateTime  @default(now())
  updated_at            DateTime? @updatedAt

  id_student Int
  student    User @relation("AeePlanStudent", fields: [id_student], references: [id], onDelete: Restrict)

  id_author Int?
  author    User? @relation("AeePlanAuthor", fields: [id_author], references: [id], onDelete: SetNull)

  @@unique([id_student, semester])
  @@index([id_author])
}

model PeiEntry {
  id                    Int       @id @default(autoincrement())
  semester              String
  subject               String
  adapted_objectives    String
  prioritized_contents  String
  syllabus_adaptations  Json
  adapted_methodologies String
  adapted_assessments   String
  adapted_resources     String
  general_notes         String
  semester_progress     String    @default("")
  semester_difficulties String    @default("")
  next_semester_notes   String    @default("")
  individual_sessions   String    @default("")
  created_at            DateTime  @default(now())
  updated_at            DateTime? @updatedAt
  deleted_at            DateTime?

  id_student Int
  student    User @relation("PeiEntryStudent", fields: [id_student], references: [id], onDelete: Restrict)

  id_author Int?
  author    User? @relation("PeiEntryAuthor", fields: [id_author], references: [id], onDelete: SetNull)

  @@unique([id_student, semester, subject], where: { deleted_at: null })
  @@index([id_student])
  @@index([id_author])
}
